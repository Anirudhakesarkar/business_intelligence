# Login default API URL (production: https://orionalerts.io; local dev: http://localhost:8788)
# NEXT_PUBLIC_DEFAULT_SERVER_URL=https://orionalerts.io

# Production dashboard: allow the backend origin for /api/proxy and login (required when NODE_ENV=production)
# ALLOWED_API_ORIGINS=https://orionalerts.io

# Optional: persist GPT summaries + daily scores to Postgres (run server migrations 067-072 first)
# DATABASE_URL=postgresql://vms:vms@localhost:5432/vms
# SCHOOL_INTELLIGENCE_DB=1

# Optional: OpenAI for live GPT (falls back to grounded demo text if unset)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# JSON snapshot across dev server restarts (default on when unset).
# SCHOOL_SNAPSHOT=1
#
# Strict DB-only acceptance (no snapshot fallback on the running Next.js process):
#   1. Set SCHOOL_SNAPSHOT=0 below (in .env.local, not only in the shell).
#   2. Restart: npm run dev
#   3. Run: npm run accept:school-management:strict
# The script checks /api/school-db/status.strictDbMode on the server — exporting
# SCHOOL_SNAPSHOT=0 only for the npm script is not enough without restarting dev.
# SCHOOL_SNAPSHOT=0
#
# Hide demo seed buttons and treat DB as production acceptance target
# SCHOOL_PRODUCTION_MODE=1
# Seed aggregator grounding rows: npm run db:seed:cloud-zone-activity
# School RBAC (set to 1 in production)
# SCHOOL_RBAC=0
# SCHOOL_API_KEY=change-me-service-key
# SCHOOL_CRON_SECRET=change-me-cron-secret
# SCHOOL_AUTH_VERIFY=proxy

