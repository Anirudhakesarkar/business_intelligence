# Baked into production dashboard builds (or set on EC2 when running `next build`).
NEXT_PUBLIC_DEFAULT_SERVER_URL=https://orionalerts.io

# Required in production so login/proxy can call the API (comma-separated origins).
ALLOWED_API_ORIGINS=https://orionalerts.io

# School Management: Postgres-only, hide demo seed UI (see .env.example)
SCHOOL_PRODUCTION_MODE=1
SCHOOL_SNAPSHOT=0
